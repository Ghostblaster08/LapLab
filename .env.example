# ==============================================================================
# HOMELAB CENTRAL CONFIGURATION TEMPLATE (.env.example)
# Copy this file to '.env' and update the values to match your system.
# Command: cp .env.example .env
# ==============================================================================

# User & Group ID permissions (Run 'id -u' and 'id -g' to check your values)
PUID=1000
PGID=1000

# Server Timezone (e.g. UTC, America/New_York, Europe/London, Asia/Kolkata)
TZ=UTC

# Host Local Network IP (Run 'ip -4 addr' or 'hostname -I' to find this)
HOST_IP=192.168.1.100

# Base project directory on primary fast NVMe/SSD storage
HOMELAB_ROOT=/path/to/your/homeLabs
APPDATA_PATH=/path/to/your/homeLabs/appdata

# Bulk storage mount path (e.g. secondary HDD/SSD, NAS mount, or extra drive)
STORAGE_PATH=/mnt/storage

# ------------------------------------------------------------------------------
# Tailscale Mesh Networking
# ------------------------------------------------------------------------------
# Optional: Pre-auth key from https://login.tailscale.com/admin/settings/keys
# If left blank, you can log in interactively via the URL printed in: docker logs tailscale
TS_AUTHKEY=

# Your machine's Tailscale IP (Assigned automatically in Tailscale dashboard, e.g. 100.x.y.z)
TAILSCALE_IP=100.82.40.45

# ------------------------------------------------------------------------------
# Immich Photo Cloud & AI Search Database Credentials
# ------------------------------------------------------------------------------
DB_USERNAME=postgres
DB_PASSWORD=choose_a_strong_database_password_here
DB_DATABASE_NAME=immich

# ------------------------------------------------------------------------------
# Media & Torrent VPN Stack (Optional - Stack 06)
# ------------------------------------------------------------------------------
# Gluetun WireGuard / OpenVPN credentials (e.g. Mullvad, ProtonVPN, AirVPN)
GLUETUN_WG_PRIVATE_KEY=CHANGE_ME
GLUETUN_WG_ADDRESS=CHANGE_ME/32
