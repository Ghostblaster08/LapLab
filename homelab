#!/usr/bin/env bash
# ==============================================================================
# Homelab CLI Controller
# Location: ~/.local/bin/homelab
# ==============================================================================

set -eo pipefail

HOMELAB_DIR="${HOMELAB_ROOT:-$HOME/Projects/homeLabs}"
STACKS_DIR="$HOMELAB_DIR/stacks"

# Color definitions
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m'

STACKS=(
    "01-network"
    "02-management"
    "03-storage"
    "04-media"
)

show_help() {
    echo -e "${BOLD}Homelab Management CLI${NC}"
    echo -e "Usage: ${CYAN}homelab${NC} [command]\n"
    echo -e "Commands:"
    echo -e "  ${GREEN}status${NC}     Show live health, Tailscale peers, and service URLs (default)"
    echo -e "  ${GREEN}start${NC}      Start all homelab Docker stacks in order"
    echo -e "  ${GREEN}stop${NC}       Gracefully stop all homelab Docker stacks"
    echo -e "  ${GREEN}restart${NC}    Restart all homelab Docker stacks"
    echo -e "  ${GREEN}logs${NC} [svc] View logs for a specific container (e.g. homelab logs immich_server)"
    echo -e "  ${GREEN}pull${NC}       Update container images to latest"
    echo -e "  ${GREEN}help${NC}       Show this message"
}

cmd_status() {
    echo -e "${BLUE}==================================================================${NC}"
    echo -e "${BOLD}${GREEN}               🏠 Homelab Server Health & Status                  ${NC}"
    echo -e "${BLUE}==================================================================${NC}\n"

    # 1. Tailscale Status
    echo -e "${BOLD}${YELLOW}[1] Tailscale Mesh Network:${NC}"
    if docker ps --format '{{.Names}}' | grep -q "^tailscale$"; then
        TS_IP=$(docker exec tailscale tailscale ip -4 2>/dev/null || echo "Unknown")
        echo -e "  • Tailscale IP: ${GREEN}${TS_IP}${NC} (homelab-laptop)"
        echo -e "  • Connected Peers:"
        docker exec tailscale tailscale status 2>/dev/null | grep -E "android|linux|windows|apple" | while read -r line; do
            echo -e "    - $line"
        done || true
    else
        echo -e "  • Tailscale container: ${RED}NOT RUNNING${NC}"
    fi

    # 2. Host Services (Sunshine & SSH)
    echo -e "\n${BOLD}${YELLOW}[2] Host Services:${NC}"
    if systemctl --user is-active --quiet sunshine; then
        echo -e "  • Sunshine (Moonlight Game/Desktop Stream): ${GREEN}Active (Running)${NC}"
    else
        echo -e "  • Sunshine: ${RED}Inactive${NC} (run: systemctl --user start sunshine)"
    fi

    if systemctl is-active --quiet sshd; then
        echo -e "  • OpenSSH Daemon (Remote Terminal):        ${GREEN}Active (Listening on port 22)${NC}"
    else
        echo -e "  • OpenSSH: ${RED}Inactive${NC} (run: sudo systemctl start sshd)"
    fi

    # 3. Docker Containers Status
    echo -e "\n${BOLD}${YELLOW}[3] Docker Containers:${NC}"
    docker ps --format "table   • {{.Names}}\t{{.Status}}\t{{.Ports}}" | head -n 25

    # 4. Quick Access URLs
    echo -e "\n${BOLD}${YELLOW}[4] Quick Access URLs (Over Tailscale):${NC}"
    echo -e "  • Homepage (Master Portal):  ${CYAN}http://100.82.40.45:3005${NC}"
    echo -e "  • Dockge (Stack Manager):    ${CYAN}http://100.82.40.45:5001${NC}"
    echo -e "  • Immich (Photos & AI):      ${CYAN}http://100.82.40.45:2283${NC}"
    echo -e "  • Jellyfin (Media Streamer): ${CYAN}http://100.82.40.45:8096${NC}"
    echo -e "  • File Browser (Web NAS):    ${CYAN}http://100.82.40.45:8085${NC}"
    echo -e "  • AdGuard Home (Ad Blocker): ${CYAN}http://100.82.40.45:8080${NC}"
    echo -e "  • Sunshine (Desktop Stream): ${CYAN}https://100.82.40.45:47990${NC}"
    echo -e "  • Uptime Kuma (Monitoring):  ${CYAN}http://100.82.40.45:3001${NC}\n"
}

cmd_start() {
    echo -e "${GREEN}Starting all Homelab Stacks...${NC}"
    for stack in "${STACKS[@]}"; do
        if [ -f "$STACKS_DIR/$stack/docker-compose.yml" ]; then
            echo -e "${YELLOW}--> Starting stack: $stack${NC}"
            docker compose -f "$STACKS_DIR/$stack/docker-compose.yml" up -d
        fi
    done
    echo -e "${GREEN}✓ All stacks started.${NC}"
}

cmd_stop() {
    echo -e "${YELLOW}Stopping all Homelab Stacks...${NC}"
    for (( i=${#STACKS[@]}-1; i>=0; i-- )); do
        stack="${STACKS[i]}"
        if [ -f "$STACKS_DIR/$stack/docker-compose.yml" ]; then
            echo -e "${YELLOW}--> Stopping stack: $stack${NC}"
            docker compose -f "$STACKS_DIR/$stack/docker-compose.yml" stop
        fi
    done
    echo -e "${GREEN}✓ All stacks stopped.${NC}"
}

cmd_restart() {
    cmd_stop
    sleep 2
    cmd_start
}

cmd_logs() {
    local target="${1:-}"
    if [ -z "$target" ]; then
        echo -e "${YELLOW}Available containers:${NC}"
        docker ps --format "{{.Names}}"
        echo -e "\nUsage: homelab logs <container_name>"
        exit 1
    fi
    docker logs -f --tail 100 "$target"
}

cmd_pull() {
    echo -e "${YELLOW}Pulling latest images for all stacks...${NC}"
    for stack in "${STACKS[@]}"; do
        if [ -f "$STACKS_DIR/$stack/docker-compose.yml" ]; then
            echo -e "${YELLOW}--> Pulling stack: $stack${NC}"
            docker compose -f "$STACKS_DIR/$stack/docker-compose.yml" pull
        fi
    done
    echo -e "${GREEN}✓ All images pulled. Run 'homelab restart' to apply.${NC}"
}

case "${1:-status}" in
    status)
        cmd_status
        ;;
    start)
        cmd_start
        ;;
    stop)
        cmd_stop
        ;;
    restart)
        cmd_restart
        ;;
    logs)
        cmd_logs "${2:-}"
        ;;
    pull)
        cmd_pull
        ;;
    help|--help|-h)
        show_help
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}\n"
        show_help
        exit 1
        ;;
esac
